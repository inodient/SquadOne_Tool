# ── LLM Provider ────────────────────────────────────────────────────────────
# 선택: ollama | gemini | anthropic
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama 일 때)
# 기본 로컬 주소: http://localhost:11434
OLLAMA_BASE_URL=

# 모델 ID — 프로바이더별 예시:
#   ollama:    llama3.1:8b, qwen2.5:7b
#   gemini:    gemini-2.0-flash, gemini-1.5-pro
#   anthropic: claude-sonnet-4-6, claude-haiku-4-5-20251001
LLM_MODEL=llama3.1:8b

# API Keys (해당 프로바이더 사용 시에만 설정)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 테스트·CI용: true 이면 LLM 호출 없이 큐 응답 사용
MOCK_LLM=false

# Planner에서 Playwright 생략 (단위/통합 스타일)
SKIP_BROWSER=false

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# Limits
MAX_RETRIES=3
GENERATOR_LLM_RETRIES=3
EXECUTOR_TIMEOUT_SEC=120

# ── ReAct Agent ─────────────────────────────────────────────────────────────
# 최대 LLM 스텝 수 (초과 시 강제 종료)
REACT_MAX_STEPS=20
# LLM 호출 사이 대기 시간(초) — Gemini 무료 티어 429 방지용 (예: 4.0)
REACT_STEP_DELAY_SEC=0.0

# ── Selector Cache ───────────────────────────────────────────────────────────
# 캐시 유효 기간(일) — 이 기간 초과 시 재발견
CACHE_STALE_DAYS=7
# 연속 실패 횟수 초과 시 캐시 무효화
CACHE_MAX_FAILURES=3

# ── Batch ────────────────────────────────────────────────────────────────────
BATCH_MAX_WORKERS=4

# ── Live tests (optional) ────────────────────────────────────────────────────
LIVE_TEST_URL=
LIVE_TEST_OBJECTIVE=
