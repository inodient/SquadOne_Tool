# SquadOne_Tool 환경설정 예시 — 복사하여 .env 로 사용하세요.
#   cp .env.example .env  후 값 채우기
# .env 는 .gitignore 로 제외됩니다(시크릿 커밋 금지).

# --- PostgreSQL (db/config.py) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Qdrant (db/config.py) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- LLM (steps/llm_factory.py) ---
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama3.1:8b
OLLAMA_TEMPERATURE=0.1

# --- Embedding (steps/qdrant_embed.py) ---
SQUADONE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
SQUADONE_EMBED_DEVICE=auto

# --- REST MCP Server (rest_mcp_server/app.py) ---
REST_MCP_API_KEY=

# --- Logging (tool_news_trend.py / rest_mcp_server/app.py) ---
MCP_LOG_LEVEL=INFO
REST_LOG_LEVEL=INFO

# --- 파일 산출 토글 (steps/common.py: write_csv/write_json/export) ---
# true(기본): CSV/JSON 파일을 DB와 병행 출력
# false: 파일 출력 생략, DB만 적재 (data/output 폭증 방지)
# 1~4단계는 단계 간 전달을 DB(newstrend 스키마)로 일원화했으므로 false 로 두어도
# 전체/단독 실행이 모두 동작한다(CSV/JSON 은 순수 디버깅 산출물). 5~7단계 포함
# 전체 파이프라인 DB-only 검증이 끝나기 전까지 기본값은 true 로 둔다.
SQUADONE_WRITE_FILES=true

# 선택: 다른 .env 경로 강제 지정
# SQUADONE_ENV_FILE=
