# SquadOne_Tool 환경설정 예시 — 복사하여 .env 로 사용하세요.
#   cp .env.example .env  후 값 채우기
# .env 는 .gitignore 로 제외됩니다(시크릿 커밋 금지).

# --- PostgreSQL (db/config.py) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Qdrant (db/config.py) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- LLM (steps/llm_factory.py) ---
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama3.1:8b
OLLAMA_TEMPERATURE=0.1

# --- Embedding (steps/qdrant_embed.py) ---
SQUADONE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
SQUADONE_EMBED_DEVICE=auto

# --- REST MCP Server (rest_mcp_server/app.py) ---
REST_MCP_API_KEY=

# --- Logging (tool_news_trend.py / rest_mcp_server/app.py) ---
MCP_LOG_LEVEL=INFO
REST_LOG_LEVEL=INFO

# 선택: 다른 .env 경로 강제 지정
# SQUADONE_ENV_FILE=
