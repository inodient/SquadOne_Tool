{
  "paths": {
    "news_dir": "data/news",
    "output_dir": "data/output",
    "stopwords_path": "config/stopwords.txt"
  },
  "news": {
    "input_source": "qdrant",
    "excel_pattern": "NewsResult_*.xlsx",
    "candidate_text_columns": ["본문", "content", "text", "article", "기사내용", "title", "제목"],
    "source_columns": ["언론사", "source", "출처", "publisher"],
    "filename_date_filter": "auto",
    "filename_date_pattern": "^NewsResult_(\\d{8})-(\\d{8})\\.xlsx$",
    "use_feature_column_mode": false,
    "category_filter_values": []
  },
  "tfidf": {
    "min_df": 50,
    "max_df": 0.7
  },
  "window": {
    "long_term_weeks": 104,
    "short_term_weeks": 1
  },
  "z_score": {
    "moving_average_span": 4,
    "high_z_score_threshold": 2.0
  },
  "keyword_class": {
    "z_threshold": 2.0,
    "seasonal": {
      "week_tolerance": 1,
      "min_seasonal_years": 3,
      "min_ratio": 0.6,
      "max_distinct_weeks": 15,
      "dictionary": ["쥐띠", "소띠", "호랑이띠", "토끼띠", "용띠", "뱀띠", "말띠", "양띠", "원숭이띠", "닭띠", "개띠", "돼지띠"]
    },
    "semantic": {
      "target_categories": ["politics"],
      "margin_threshold": 0.15,
      "min_top_similarity": 0.5,
      "_note_buzzword": "buzzword 는 의미적으로 어떤 카테고리와도 분리가 안 되고(centroid가 산만) contrast에 넣으면 politics 재현율을 해쳐 제외함. 별도 신호(recency 등) 필요.",
      "_note_dictionary": "정당 약어(정개특위·선대위·비대위)는 margin 0.15 바로 아래라 contrastive로 불안정 → 유한·기지 집합이므로 사전으로 확정 라벨(method='dictionary').",
      "dictionary": {
        "politics": ["정개특위", "선대위", "비대위", "당권", "당권파", "공관위", "최고위", "상임위", "특위", "원내대책회의", "비대위원장", "선대본", "당정청", "정무위", "운영위", "법사위", "정개특위원장", "공천관리위", "선거대책위", "비상대책위"]
      },
      "seeds": {
        "politics": ["국회", "선거", "국회의원", "정당", "대선", "공천", "원내대표", "국정감사", "야당", "여당", "비대위", "최고위원", "당대표", "정치"],
        "product": ["노트북", "원피스", "건조기", "골프", "운동화", "화장품", "가방", "의자", "냉장고", "텀블러", "패딩", "빙수"],
        "general": ["반도체", "수출", "금리", "날씨", "태풍", "환율", "주가", "유가", "부동산", "고용"]
      }
    },
    "person": {
      "enabled": true,
      "model_type": "",
      "method": "context_title",
      "_note": "맨단어 NER(PS) 폐기 → 직책어 문맥 규칙. 이름꼴(성씨+길이2~3) 후보가 기사에서 직책어(의원·판사·씨 등) 앞에 min_title_hits회 이상 오면 person. Qdrant 컨텍스트 사용.",
      "name_len": [2, 3],
      "min_title_hits": 3,
      "top_k_snippets": 10,
      "exclude_words": ["기감", "도핑", "사브르", "전관", "신라젠", "인포섹"],
      "exclude_suffixes": ["부", "과", "처", "청", "협", "망", "업", "학", "원", "대", "회", "단", "실", "국", "부서"],
      "surnames": ["김", "이", "박", "최", "정", "강", "조", "윤", "장", "임", "한", "오", "서", "신", "권", "황", "안", "송", "류", "유", "전", "홍", "고", "문", "양", "손", "배", "백", "허", "남", "심", "노", "하", "곽", "성", "차", "주", "우", "구", "민", "나", "지", "엄", "채", "원", "천", "방", "공", "현", "함", "변", "염", "여", "추", "도", "소", "석", "선", "마", "길", "위", "표", "명", "기", "반", "왕", "금", "옥", "육", "인", "맹", "제", "모", "탁", "국", "어", "은", "편", "용", "예", "경", "봉", "사", "부", "복", "목", "형", "계", "피", "두", "감", "음", "빈", "동", "온"],
      "titles": ["의원", "대표", "장관", "차관", "대통령", "후보", "위원", "위원장", "의장", "총리", "시장", "지사", "군수", "구청장", "판사", "검사", "변호사", "기자", "앵커", "교수", "박사", "회장", "사장", "부장", "감독", "선수", "코치", "작가", "배우", "가수", "아나운서", "총장", "이사장", "장군", "목사", "신부", "씨", "군", "양", "옹"]
    }
  },
  "keysentence_extractor": {
    "keywords_per_week": 8,
    "min_docs": 10,
    "max_docs": 30,
    "scroll_limit": 160,
    "scroll_max_pages": 8,
    "server_week_filter_file_overlap": true
  },
  "keyword_extractor": {
    "context": {
      "enabled": true,
      "top_n": 2000,
      "samples": 3,
      "neighbor_top_k": 5
    },
    "sense": {
      "enabled": true,
      "method": "embedding",
      "input_mode": "sentence",
      "model": null,
      "device": "auto",
      "max_senses": 4,
      "neighbor_top_k": 5,
      "title_weight": 3.0,
      "body_base_weight": 1.0,
      "body_position_decay": 0.85,
      "min_sentence_weight": 0.2,
      "min_sentence_len": 12,
      "body_lead_n": 3,
      "cluster_target_size": 135,
      "cluster_kmin": 10,
      "cluster_kmax": 110,
      "min_sense_share": 0.12,
      "noise_keywords": ["포토", "기자", "속보", "단독", "사진", "오늘", "운세", "오후", "오전", "이날", "별세", "부고", "인사", "동정", "영상", "한겨레", "연합뉴스", "사설", "칼럼", "오피니언", "기고", "발인", "정례", "무관", "정정", "알림", "지면", "화보", "뉴시스", "아시아투데이", "사람", "자신", "좋다", "문장", "이야기", "작가", "생각", "정도", "경우", "모습", "대로", "이번", "관련", "지난", "의원", "대표", "대통령", "국민", "원내", "위원장", "정부", "시민", "여당", "야당", "서울", "경기", "경기도", "서울시", "인천", "백운산", "지역", "세계", "전국"],
      "_legacy_context_mode": {
        "distance_threshold": 0.45,
        "max_contexts_per_kw": 80,
        "min_occ_for_split": 5,
        "min_contexts_for_split": 3
      }
    }
  },
  "trend_linker": {
    "alpha": 0.15,
    "beta": 0.85,
    "theta_near": 0.42,
    "theta_gap": 0.47,
    "max_gap_weeks": 30,
    "min_ent_jaccard": 0.25,
    "min_ent_jaccard_near": 0.10
  },
  "trend_extractor": {
    "anchor_top_n": 5,
    "persistence_min_count": 3,
    "exclude_noise_classes": true,
    "exclude_classes": ["seasonal", "politics", "person"],
    "vector_top_k": 10,
    "vector_week_filter_field": "week",
    "vector_date_coverage": ["2016-W01", "2022-W52"],
    "semantic_group_threshold": 0.72,
    "max_groups_per_week": 5,
    "group_link_threshold": 0.75,
    "group_score_weights": {
      "z_sum": 1.0,
      "count_log": 1.2,
      "ctx_mean": 1.0,
      "cohesion": 1.0
    },
    "llm_provider_default": "ollama",
    "llm_temperature": 0.1,
    "max_tokens": 1024,
    "llm_model_map": {
      "individual_summary": "llama3.1:8b",
      "sequential_analysis": "llama3.1:8b",
      "report": "llama3.1:8b"
    }
  },
  "vector_db": {
    "provider": "qdrant",
    "qdrant_url": null,
    "collection": "news_10y_ko_v1",
    "week_filter_field": "week",
    "date_field": "date",
    "date_start_field": "file_date_start",
    "date_end_field": "file_date_end",
    "top_k": 10,
    "timeout_sec": 20,
    "embed_model": "sentence-transformers/paraphrase-multilingual-mpnet-base-v2",
    "embed_device": "auto",
    "enable_query_embedding": true,
    "query_vector_name": "body",
    "use_server_date_filter": true,
    "server_week_filter_file_overlap": true,
    "vector_search_limit_multiplier": 3,
    "vector_search_min_limit": 30,
    "scroll_limit_multiplier": 12,
    "scroll_min_limit": 100,
    "scroll_max_pages": 12,
    "week_scroll_mode": "default",
    "scroll_full_week_max_pages": 0
  },
  "lifecycle": {
    "emerging_z_threshold": 2.0,
    "active_min_count_ratio": 0.7,
    "fading_z_threshold": 0.8,
    "fading_count_ratio": 0.4,
    "first_seen_lookback_weeks": 4
  },
  "product_extractor": {
    "max_products": 5,
    "test_defaults": {
      "test_mode": false,
      "test_week_offset": 0,
      "test_max_weeks": 10
    },
    "llm_roles": {
      "context_analyst": "context_analyst",
      "product_md": "product_md"
    },
    "constraints": {
      "ip_clean": "특정 인물, 브랜드, 캐릭터 IP가 필요한 상품은 제외",
      "logistics": "부피가 큰 상품, 파손 위험이 큰 상품, 인증이 까다로운 제품은 제외",
      "generic_naming": "도매 사이트(1688, 도매꾹)에서 검색 가능한 일반 명사 형태로 제안"
    }
  },
  "export": {
    "json_orient": "records",
    "json_lines": true,
    "json_indent": null,
    "full_max_rows": 200000,
    "full_max_cols": 400,
    "sample_rows": 200
  },

  "ingest": {
    "data_dir": "data/news",
    "collection": "news_10y_ko_v1",
    "embed_model": "sentence-transformers/paraphrase-multilingual-mpnet-base-v2",
    "embed_device": "auto",
    "batch_size": 128,
    "encode_batch_size": 64,
    "named_vectors": ["title", "body"],
    "distance": "cosine",
    "normalize_embeddings": true,
    "startup_retries": 8,
    "startup_retry_delay_sec": 2,
    "upsert_timeout_sec": 120,
    "upsert_retries": 4,
    "use_db_state": true
  },

  "clustering": {
    "enabled": true,
    "mode": "article_title",
    "top_z_keywords": 30,
    "max_titles_per_keyword": 15,
    "max_total_titles": 8000,
    "embedding_backend": "ko-sbert",
    "embedding_fallbacks": ["kosimcse", "tfidf", "length"],
    "umap": {"n_neighbors": 15, "n_components": 5, "min_dist": 0.0, "metric": "cosine"},
    "hdbscan": {"min_cluster_size": 5, "min_samples": 1, "metric": "euclidean"},
    "ctfidf_top_terms": 8,
    "theme_llm_role": "cluster_theme",
    "interpretation_llm_role": "cluster_interpretation",
    "include_noise_cluster": false
  },

  "long_term_trend": {
    "enabled": true,
    "window_weeks": 156,
    "min_active_ratio": 0.2,
    "min_active_weeks": 36,
    "min_mean_z": 0.15,
    "min_p75_z": 0.5,
    "min_slope": -0.002,
    "min_long_term_score": 0.55,
    "score_weights": {"active_ratio": 0.35, "mean_z": 0.2, "p75_z": 0.15, "slope": 0.15, "consecutive": 0.15},
    "top_n_per_week": 80,
    "spike_z_fallback": 2.5
  },

  "trend_time_series": {
    "enabled": true,
    "anchor_top_n": 8,
    "survival_threshold": 0.5,
    "stop_after_weeks_below": 4
  },

  "period_trend": {
    "enabled": true,
    "micro_spike_pct": 200.0,
    "macro_window_days": 90,
    "macro_ma_days": 7,
    "macro_min_beta": 0.0,
    "macro_min_r2": 0.7,
    "momentum_z_strong": 2.0,
    "recency_window_weeks": 4,
    "top_keywords": 40
  },

  "llm_questionarie": {
    "enabled": true,
    "step_61": {"max_article_chars": 20000, "llm_role": "trend_brief"},
    "step_62": {"num_products": 10, "llm_role": "related_products"},
    "step_63": {"num_queries": 12, "llm_role": "youtube_queries"}
  },

  "geo_query": {
    "enabled": true,
    "drop_noise_cluster": true,
    "llm_role": "geo_query",
    "queries_per_cluster": 3
  },

  "youtube_signal": {
    "enabled": true,
    "api_key_env": ["YOUTUBE_API_KEY", "GOOGLE_API_KEY", "YT_API_KEY"],
    "region_code": "KR",
    "relevance_language": "ko",
    "max_results": 20,
    "weights": {"w1": 0.25, "w2": 0.25, "w3": 0.25, "w4": 0.25},
    "z_threshold": 2.0,
    "recency_weeks": 4,
    "volume_norm": "batch",
    "volume_global_log10_cap": 8.0,
    "engagement_norm": "minmax",
    "engagement_absolute_ratio_cap": 0.08,
    "context_keywords": ["리뷰", "추천", "꿀템", "내돈내산", "후기", "언박싱", "솔직", "비교"]
  },

  "demand_forecast": {
    "enabled": true,
    "naver_datalab": true,
    "pytrends": true,
    "llm_role": "demand_analyst",
    "delay_sec": 1.0
  },

  "market_competition": {
    "enabled": true,
    "naver_shopping": true,
    "llm_role": "market_analyst",
    "sample_size": 40
  },

  "social_vibe": {
    "enabled": true,
    "min_videos": 8,
    "llm_role": "social_analyst",
    "delay_sec": 1.0
  },

  "naver_categories": {
    "enabled": true,
    "base_delay_sec": 0.38,
    "jitter_sec": 0.12,
    "grounding_fuzzy_match": true
  }
}
